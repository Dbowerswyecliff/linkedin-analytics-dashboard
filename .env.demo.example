# Demo-only environment variables
# Copy to .env.demo and fill in values from your DEMO Supabase project

# Enables demo mode (mock data, lead gate, no live integrations)
VITE_DEMO_MODE=true

# Demo-only Supabase project for lead capture (INSERT-only)
VITE_SUPABASE_URL=https://YOUR_DEMO_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-demo-anon-key-here

# --- MUST be blank or absent in demo builds ---
# VITE_LINKEDIN_CLIENT_ID=
# VITE_LINKEDIN_AUTH_FUNCTION_URL=
# VITE_LINKEDIN_SYNC_URL=
# VITE_MONDAY_CLIENT_ID=
# VITE_MONDAY_AUTH_FUNCTION_URL=
# VITE_TEST_USERNAME=
# VITE_TEST_PASSWORD=
